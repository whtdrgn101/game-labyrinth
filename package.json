{
  "name": "@game-hub/game-labyrinth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Labyrinth (Ravensburger, The aMAZEing Labyrinth) as a Game Hub game package — the first game built OUTSIDE the platform monorepo, against the published @game-hub/kernel and @game-hub/ui-kit. Four subpath exports over TypeScript source: ./engine (pure rules core), ./module (backend GameModule seam), ./client (UI GameClient seam), ./bot (AI).",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whtdrgn101/game-labyrinth.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "exports": {
    "./engine": "./src/engine/index.ts",
    "./module": "./src/module/index.ts",
    "./client": "./src/client/index.ts",
    "./bot": "./src/bot/index.ts"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@game-hub/kernel": "^1.1.0",
    "@game-hub/ui-kit": "^1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@game-hub/kernel": "^1.1.0",
    "@game-hub/ui-kit": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
